# Local development only — the Worker never reads this file; its database is
# the HYPERDRIVE binding (wrangler.jsonc's localConnectionString locally) and
# its Algolia keys are Worker secrets (`.dev.vars` locally, below).
#
# A Postgres connection string for `pnpm db:migrate` (which defaults to the
# Supabase CLI's database below) and for `next dev` without wrangler.
POSTGRES_URL=postgres://postgres:postgres@localhost:54322/postgres
# Optional: the site's public origin for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# The Algolia application and its search-only key go in apps/web/.dev.vars
# (wrangler dev and `next dev` read it as the Worker's secrets), never here:
#   ALGOLIA_APP_ID=…
#   ALGOLIA_SEARCH_API_KEY=…
# Without them the home page says search is not connected and lists the
# catalogue from Postgres. The write/admin key is never needed: the connector
# indexes from Algolia's dashboard.
